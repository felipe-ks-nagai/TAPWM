<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>inscricao</title>
</head>
<body>
    <section>
        <h2>Inscrição</h2>

        <form>
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" placeholder="Digite seu nome">

            <br><br>

            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email" placeholder="Digite seu e-mail">

            <br><br>

            <label for="telefone">Telefone:</label>
            <input type="tel" id="telefone" name="telefone" placeholder="Digite seu telefone">

            <br><br>

            <label for="evento">Escolha uma atividade:</label>
            <select id="evento" name="evento">
                <option>Palestra: Inteligência Artificial</option>
                <option>Workshop: Introdução à Programação</option>
                <option>Palestra: Segurança Digital</option>
                <option>Workshop: Desenvolvimento de Sites</option>
                <option>Palestra: Tecnologia e Inovação</option>
                <option>Workshop: Criando seu primeiro aplicativo</option>
            </select>

            <br><br>

            <button type="button">Inscrever-se</button>
        </form>
    </section>

</body>
</html>